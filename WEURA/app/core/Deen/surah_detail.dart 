import 'package:flutter/material.dart';

import '../../components/Deen/islamic_background.dart';
import '../../components/Deen/verse_card.dart';
import '../../core/Deen/deen_models.dart';
import '../../services/Deen/quran_service.dart';

/// صفحة قراءة السورة
class SurahDetailScreen extends StatefulWidget {
  const SurahDetailScreen({super.key, required this.surah});

  final SurahMeta surah;

  @override
  State<SurahDetailScreen> createState() => _SurahDetailScreenState();
}

class _SurahDetailScreenState extends State<SurahDetailScreen> {
  static const _gold = Color(0xFFD4AF37);
  static const _cream = Color(0xFFF5F0E1);

  final QuranService _service = QuranService();
  final ScrollController _scroll = ScrollController();

  List<QuranVerse> _verses = const [];
  bool _isLoading = true;
  String? _error;
  int? _highlightedAyah;

  @override
  void initState() {
    super.initState();
    _load();
  }

  @override
  void dispose() {
    _scroll.dispose();
    _service.dispose();
    super.dispose();
  }

  Future<void> _load({bool force = false}) async {
    setState(() {
      _isLoading = true;
      _error = null;
    });

    try {
      final verses = await _service.getSurahVerses(
        widget.surah.number,
        forceRefresh: force,
      );
      if (!mounted) return;
      setState(() {
        _verses = verses;
        _isLoading = false;
      });
    } catch (e) {
      if (!mounted) return;
      setState(() {
        _error = e.toString();
        _isLoading = false;
      });
    }
  }

  void _onVerseTap(int ayahNumber) {
    setState(() => _highlightedAyah = ayahNumber);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF04160F),
      appBar: AppBar(
        backgroundColor: Colors.transparent,
        elevation: 0,
        iconTheme: const IconThemeData(color: _cream),
        title: Column(
          children: [
            Text(
              widget.surah.arabicName,
              style: const TextStyle(
                color: _cream,
                fontWeight: FontWeight.w700,
                fontFamily: 'serif',
                fontSize: 18,
              ),
            ),
            const SizedBox(height: 2),
            Text(
              '${widget.surah.place} • ${widget.surah.ayahCount} آية',
              style: TextStyle(
                color: _cream.withValues(alpha: 0.55),
                fontSize: 11,
              ),
            ),
          ],
        ),
        centerTitle: true,
        actions: [
          IconButton(
            tooltip: 'تحديث',
            onPressed: _isLoading ? null : () => _load(force: true),
            icon: const Icon(Icons.refresh_rounded),
          ),
        ],
      ),
      extendBodyBehindAppBar: true,
      body: IslamicBackground(
        child: SafeArea(
          child: _isLoading
              ? _loadingState()
              : _error != null
                  ? _errorState()
                  : _versesState(),
        ),
      ),
    );
  }

  Widget _loadingState() {
    return const Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          SizedBox(
            width: 34,
            height: 34,
            child: CircularProgressIndicator(
              strokeWidth: 2.5,
              color: _gold,
            ),
          ),
          SizedBox(height: 16),
          Text(
            'جاري التحميل...',
            style: TextStyle(color: _cream, fontSize: 14),
          ),
        ],
      ),
    );
  }

  Widget _errorState() {
    return Center(
      child: Padding(
        padding: const EdgeInsets.all(30),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Icon(
              Icons.cloud_off_rounded,
              size: 56,
              color: _gold,
            ),
            const SizedBox(height: 16),
            const Text(
              'تعذر تحميل السورة',
              style: TextStyle(
                color: _cream,
                fontSize: 17,
                fontWeight: FontWeight.w600,
              ),
            ),
            const SizedBox(height: 10),
            Text(
              _error ?? '',
              textAlign: TextAlign.center,
              style: TextStyle(
                color: _cream.withValues(alpha: 0.6),
                fontSize: 12,
              ),
            ),
            const SizedBox(height: 20),
            FilledButton.icon(
              onPressed: () => _load(force: true),
              style: FilledButton.styleFrom(
                backgroundColor: _gold,
                foregroundColor: const Color(0xFF04160F),
              ),
              icon: const Icon(Icons.refresh_rounded),
              label: const Text('إعادة المحاولة'),
            ),
          ],
        ),
      ),
    );
  }

  Widget _versesState() {
    if (_verses.isEmpty) {
      return const Center(
        child: Text(
          'لا توجد آيات',
          style: TextStyle(color: _cream),
        ),
      );
    }

    return Column(
      children: [
        // البسملة (إلا للفاتحة والتوبة)
        if (widget.surah.number != 1 && widget.surah.number != 9)
          Padding(
            padding: const EdgeInsets.fromLTRB(16, 16, 16, 10),
            child: Container(
              padding: const EdgeInsets.symmetric(
                horizontal: 20,
                vertical: 14,
              ),
              decoration: BoxDecoration(
                color: _gold.withValues(alpha: 0.08),
                borderRadius: BorderRadius.circular(14),
                border: Border.all(
                  color: _gold.withValues(alpha: 0.25),
                ),
              ),
              child: const Directionality(
                textDirection: TextDirection.rtl,
                child: Text(
                  'بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ',
                  textAlign: TextAlign.center,
                  style: TextStyle(
                    color: _cream,
                    fontSize: 22,
                    fontFamily: 'serif',
                    height: 1.8,
                  ),
                ),
              ),
            ),
          ),

        Expanded(
          child: ListView.builder(
            controller: _scroll,
            padding: const EdgeInsets.fromLTRB(16, 8, 16, 24),
            itemCount: _verses.length,
            itemBuilder: (context, i) {
              final v = _verses[i];
              return VerseCard(
                verse: v,
                highlighted: _highlightedAyah == v.ayahNumber,
                onTap: () => _onVerseTap(v.ayahNumber),
                onLongPress: () => _showVerseOptions(v),
              );
            },
          ),
        ),
      ],
    );
  }

  void _showVerseOptions(QuranVerse verse) {
    showModalBottomSheet<void>(
      context: context,
      backgroundColor: const Color(0xFF0A1F17),
      showDragHandle: true,
      builder: (_) {
        return SafeArea(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              Padding(
                padding: const EdgeInsets.all(16),
                child: Text(
                  'الآية ${verse.ayahNumber}',
                  style: const TextStyle(
                    color: _cream,
                    fontSize: 17,
                    fontWeight: FontWeight.w700,
                  ),
                ),
              ),
              ListTile(
                leading: const Icon(Icons.copy_rounded, color: _gold),
                title: const Text(
                  'نسخ الآية',
                  style: TextStyle(color: _cream),
                ),
                onTap: () {
                  Navigator.pop(context);
                  // TODO: copy to clipboard
                },
              ),
              ListTile(
                leading: const Icon(Icons.bookmark_border_rounded, color: _gold),
                title: const Text(
                  'حفظ في المفضلة',
                  style: TextStyle(color: _cream),
                ),
                onTap: () => Navigator.pop(context),
              ),
              ListTile(
                leading: const Icon(Icons.share_outlined, color: _gold),
                title: const Text(
                  'مشاركة',
                  style: TextStyle(color: _cream),
                ),
                onTap: () => Navigator.pop(context),
              ),
              const SizedBox(height: 8),
            ],
          ),
        );
      },
    );
  }
}