import 'dart:convert';

import 'package:http/http.dart' as http;

import '../../core/Deen/deen_models.dart';
import '../Storage/storage_service.dart';

/// خدمة القرآن الكريم
///
/// - تجلب الآيات من quran.com API v4
/// - تخزنها محلياً للاستعمال بدون إنترنت
class QuranService {
  QuranService({http.Client? client}) : _client = client ?? http.Client();

  final http.Client _client;

  static const String _baseUrl = 'https://api.quran.com/api/v4';
  static const String _cachePrefix = 'weura_quran_cache_';

  /// جلب كل آيات السورة
  Future<List<QuranVerse>> getSurahVerses(
    int surahNumber, {
    bool forceRefresh = false,
  }) async {
    if (!forceRefresh) {
      final cached = await _readCache(surahNumber);
      if (cached != null && cached.isNotEmpty) return cached;
    }

    try {
      final verses = await _fetchFromApi(surahNumber);
      if (verses.isNotEmpty) {
        await _writeCache(surahNumber, verses);
        return verses;
      }
    } catch (e) {
      // الرجوع للـcache إذا فشل الاتصال
      final cached = await _readCache(surahNumber);
      if (cached != null) return cached;
      rethrow;
    }

    return const [];
  }

  Future<List<QuranVerse>> _fetchFromApi(int surahNumber) async {
    final uri = Uri.parse(
      '$_baseUrl/verses/by_chapter/$surahNumber'
      '?fields=text_uthmani&per_page=300',
    );

    final response = await _client.get(
      uri,
      headers: const {'Accept': 'application/json'},
    ).timeout(const Duration(seconds: 20));

    if (response.statusCode != 200) {
      throw Exception('فشل تحميل السورة (HTTP ${response.statusCode})');
    }

    final decoded = jsonDecode(response.body) as Map<String, dynamic>;
    final versesRaw = decoded['verses'];

    if (versesRaw is! List) return const [];

    final verses = <QuranVerse>[];
    for (final item in versesRaw) {
      if (item is! Map) continue;
      final ayahNumber = int.tryParse(
        item['verse_number']?.toString() ?? '',
      );
      final text = item['text_uthmani']?.toString() ?? '';
      if (ayahNumber == null || text.isEmpty) continue;

      verses.add(
        QuranVerse(
          surahNumber: surahNumber,
          ayahNumber: ayahNumber,
          text: text,
        ),
      );
    }

    verses.sort((a, b) => a.ayahNumber.compareTo(b.ayahNumber));
    return verses;
  }

  Future<List<QuranVerse>?> _readCache(int surahNumber) async {
    try {
      final key = '$_cachePrefix$surahNumber';
      final raw = await StorageService.instance
          .read<List<dynamic>>(key);
      if (raw == null) return null;

      return raw
          .whereType<Map>()
          .map((item) => QuranVerse.fromJson(
                Map<String, dynamic>.from(item),
              ))
          .toList();
    } catch (_) {
      return null;
    }
  }

  Future<void> _writeCache(
    int surahNumber,
    List<QuranVerse> verses,
  ) async {
    try {
      final key = '$_cachePrefix$surahNumber';
      await StorageService.instance.write(
        key,
        verses.map((v) => v.toJson()).toList(),
      );
    } catch (_) {}
  }

  /// حذف كل الـcache
  Future<void> clearCache() async {
    for (int i = 1; i <= 114; i++) {
      await StorageService.instance.delete('$_cachePrefix$i');
    }
  }

  void dispose() {
    _client.close();
  }
}