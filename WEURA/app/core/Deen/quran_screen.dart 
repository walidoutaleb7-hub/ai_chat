import 'package:flutter/material.dart';

import '../../components/Deen/islamic_background.dart';
import '../../core/Deen/deen_models.dart';
import '../../core/Deen/surah_data.dart';
import 'surah_detail.dart';

/// قائمة السور الـ114
class QuranScreen extends StatefulWidget {
  const QuranScreen({super.key});

  @override
  State<QuranScreen> createState() => _QuranScreenState();
}

class _QuranScreenState extends State<QuranScreen> {
  static const _gold = Color(0xFFD4AF37);
  static const _cream = Color(0xFFF5F0E1);

  final TextEditingController _searchController = TextEditingController();
  String _search = '';

  List<SurahMeta> get _filtered {
    if (_search.trim().isEmpty) return kSurahs;
    final q = _search.trim().toLowerCase();
    return kSurahs.where((s) {
      return s.arabicName.contains(_search.trim()) ||
          s.englishName.toLowerCase().contains(q) ||
          s.number.toString() == q;
    }).toList();
  }

  @override
  void dispose() {
    _searchController.dispose();
    super.dispose();
  }

  void _openSurah(SurahMeta surah) {
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => SurahDetailScreen(surah: surah),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final items = _filtered;

    return Scaffold(
      backgroundColor: const Color(0xFF04160F),
      appBar: AppBar(
        backgroundColor: Colors.transparent,
        elevation: 0,
        iconTheme: const IconThemeData(color: _cream),
        title: const Text(
          'القرآن الكريم',
          style: TextStyle(
            color: _cream,
            fontWeight: FontWeight.w700,
            fontFamily: 'serif',
          ),
        ),
        centerTitle: true,
      ),
      extendBodyBehindAppBar: true,
      body: IslamicBackground(
        child: SafeArea(
          child: Column(
            children: [
              const SizedBox(height: 8),

              // شريط البحث
              Padding(
                padding: const EdgeInsets.fromLTRB(16, 4, 16, 12),
                child: TextField(
                  controller: _searchController,
                  onChanged: (v) => setState(() => _search = v),
                  style: const TextStyle(color: _cream),
                  textDirection: TextDirection.rtl,
                  decoration: InputDecoration(
                    hintText: 'ابحث عن سورة...',
                    hintStyle: TextStyle(
                      color: _cream.withValues(alpha: 0.4),
                    ),
                    prefixIcon: const Icon(
                      Icons.search_rounded,
                      color: _gold,
                    ),
                    suffixIcon: _search.isNotEmpty
                        ? IconButton(
                            onPressed: () {
                              _searchController.clear();
                              setState(() => _search = '');
                            },
                            icon: Icon(
                              Icons.close_rounded,
                              color: _cream.withValues(alpha: 0.6),
                            ),
                          )
                        : null,
                    filled: true,
                    fillColor: Colors.black.withValues(alpha: 0.30),
                    border: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(16),
                      borderSide: BorderSide(
                        color: _gold.withValues(alpha: 0.20),
                      ),
                    ),
                    enabledBorder: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(16),
                      borderSide: BorderSide(
                        color: _gold.withValues(alpha: 0.20),
                      ),
                    ),
                    focusedBorder: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(16),
                      borderSide: const BorderSide(
                        color: _gold,
                        width: 1.4,
                      ),
                    ),
                  ),
                ),
              ),

              // قائمة السور
              Expanded(
                child: items.isEmpty
                    ? _emptyState()
                    : ListView.separated(
                        padding: const EdgeInsets.fromLTRB(16, 4, 16, 20),
                        itemCount: items.length,
                        separatorBuilder: (_, __) =>
                            const SizedBox(height: 8),
                        itemBuilder: (context, i) =>
                            _surahTile(items[i]),
                      ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _surahTile(SurahMeta surah) {
    return Material(
      color: Colors.transparent,
      child: InkWell(
        onTap: () => _openSurah(surah),
        borderRadius: BorderRadius.circular(14),
        child: Container(
          padding: const EdgeInsets.symmetric(
            horizontal: 14,
            vertical: 12,
          ),
          decoration: BoxDecoration(
            color: Colors.black.withValues(alpha: 0.30),
            borderRadius: BorderRadius.circular(14),
            border: Border.all(
              color: _gold.withValues(alpha: 0.15),
            ),
          ),
          child: Row(
            children: [
              // رقم السورة في شكل نجمة
              Container(
                width: 42,
                height: 42,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  color: _gold.withValues(alpha: 0.10),
                  border: Border.all(
                    color: _gold.withValues(alpha: 0.35),
                    width: 1.2,
                  ),
                ),
                child: Center(
                  child: Text(
                    surah.number.toString(),
                    style: const TextStyle(
                      color: _gold,
                      fontSize: 14,
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                ),
              ),
              const SizedBox(width: 14),

              // اسم السورة
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      surah.arabicName,
                      style: const TextStyle(
                        color: _cream,
                        fontSize: 18,
                        fontWeight: FontWeight.w600,
                        fontFamily: 'serif',
                      ),
                    ),
                    const SizedBox(height: 3),
                    Text(
                      surah.englishName,
                      style: TextStyle(
                        color: _cream.withValues(alpha: 0.5),
                        fontSize: 12,
                      ),
                    ),
                  ],
                ),
              ),

              // معلومات
              Column(
                crossAxisAlignment: CrossAxisAlignment.end,
                children: [
                  Text(
                    '${surah.ayahCount} آية',
                    style: const TextStyle(
                      color: _gold,
                      fontSize: 12,
                      fontWeight: FontWeight.w600,
                    ),
                  ),
                  const SizedBox(height: 3),
                  Text(
                    surah.place,
                    style: TextStyle(
                      color: _cream.withValues(alpha: 0.5),
                      fontSize: 11,
                    ),
                  ),
                ],
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _emptyState() {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(
            Icons.search_off_rounded,
            size: 56,
            color: _gold.withValues(alpha: 0.4),
          ),
          const SizedBox(height: 14),
          Text(
            'لا توجد نتائج',
            style: TextStyle(
              color: _cream.withValues(alpha: 0.7),
              fontSize: 16,
            ),
          ),
        ],
      ),
    );
  }
}